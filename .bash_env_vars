# termux
export EXT="/storage/emulated/091F-EDCF" # change with your sdcard
export INT="/sdcard"
export INTD="$INT/Download"

if [[ -d $INT ]]; then
        export JAVA_HOME="/data/data/com.termux/files/usr/lib/jvm"
        export PATH="$JAVA_HOME/bin:$HOME/.local/bin:$PATH"
        export LD_LIBRARY_PATH="/data/data/com.termux/files/usr/lib:$LD_LIBRARY_PATH"
fi

# apps
export EDITOR=nvim
export BROWSER=app.zen_browser.zen
export TERMINAL=alacritty

# add project build dirs to path
if [[ -d ~/projects ]]; then
        for p in ~/projects/*; do
                if [[ -d $p/build/bin ]]; then
                        export PATH="$p/build/bin:$PATH"
                fi
        done
fi

# load .env
function load_env() {
        set -a
        source $1/.env
        set +a
}

load_env ~
