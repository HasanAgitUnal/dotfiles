{
        "modules-left": [
                //"group/power",
                "custom/archlogo",
                "privacy",
                "hyprland/window"
        ],

        "modules-center": [
                "hyprland/workspaces"
        ],

        "modules-right": [
                //"group/statistics",
                "custom/syncthing",
                "memory",
                "custom/cputemp",
                "cpu",
                "pulseaudio",
                "backlight",
                "network",
                "power-profiles-daemon",
                "battery",
                "clock"
        ],


        "clock": {
                "format": "{:%H:%M | %d.%m.%Y}",
                "interval": 30,
                "tooltip": false
        },

        "battery": {
                "format": "{icon} %{capacity}",
                "states": {
                        "critical": 15
                },
                "interval": 10,
                "format-icons": {
                        "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
                        "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
                }
        },

        "power-profiles-daemon": {
                "format": "{icon}",
                "tooltip-format": "{profile}",
                "format-icons": {
                        "default": "󱐋",
                        "performance": "󱐋",
                        "balanced": " ",
                        "power-saver": "" //󰚥
                }
        },

        "network": {
                "format-wifi": "{icon} {essid}",
                "format-ethernet": "󰈀 {ifname}",
                "format-disconnected": "󰤮",
                "format-icons": {
                        "wifi": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"]
                },
                "on-click": "~/dotfiles/.config/rofi/bin/wifi",
                "tooltip": true,
                "tooltip-format" : "{ipaddr}"
        },

        "backlight": {
                "format": "{icon} %{percent}",
                "format-icons": ["󰃞", "󰃟", "󰃠"],
                "tooltip": false
        },

        "pulseaudio": {
                "format": "<span size='12500' rise='-1000'>{icon}</span> %{volume}",
                "format-muted": "<span size='12500' rise='-1000'>󰝟</span>",
                "format-icons": ["󰕿", "󰖀", "󰕾"],
                "tooltip": false
        },

        "keyboard-state": {
                "capslock": true,
                "numlock": true,
                "format": {
                        "capslock": "󰪛 {icon}",
                        "numlock": "󰽾 {icon}"
                },
                "format-icons": {
                        "locked": "",
                        "unlocked": ""
                }
        },

        "cpu": {
                "format": "  %{usage}",
                "interval" : 5
        },

        "load": {
                "format": "  {load1}",
                "interval" : 20
        },

        "memory": {
                "format": "  %{percentage}",
                "tooltip-format": "RAM:  {used:0.2f}GiB / {total}GiB\nSwap: {swapUsed:0.2f}GiB / {swapTotal}GiB",
                "interval" : 20
        },

        "disk": {
                "format": "  {free}/{total}",
                "tooltip-format": "Total: {total}\nUsed: {used}\nFree: {free}"
        },

        "hyprland/workspaces": {
                "persistent-workspaces" : {
                        "*":5
                },
                "all-outputs": true,
                "format": "{icon}",
                "format-icons": {
                        "1": "<span size='12000' rise='-1000'></span>",
                        "2": "<span size='12500' rise='-1000'>󰦨</span>",
                        "3": "<span size='12500' rise='-1000'>󰖟</span>",
                        "4": "<span size='9930' rise='-14000'></span>",

                        "5": "<span size='11450' rise='-15900'></span>",
                        "6": "<span size='13000' rise='-8000'>󰎳</span>",
                        "7": "<span size='13000' rise='-8000'>󰎶</span>",
                        "8": "<span size='13000' rise='-8000'>󰎹</span>",
                        "9": "<span size='13000' rise='-8000'>󰎼</span>",

                        "10": "󰥔"
                }
        },

        "privacy": {
                "icon-spacing":5,
                "icon-size": 16,
                "modules": [
                        {
                                "type": "screenshare",
                                "tooltip":true
                        },
                        {
                                "type": "audio-in",
                                "tooltip": true
                        }
                ]
        }
}
